---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ST_MARY_FLORA } from '@/data/flora';
import { buildBreadcrumbSchema } from '@/lib/seo';

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Why Hey Hon?', path: '/why-hey-hon' },
  ]),
];

const rows = [
  ['Bee Diet', '100% natural flower nectar, never fed sugar water', 'Often fed sugar syrup to boost output'],
  ['Packaging & Safety', 'Heavy reusable glass jars only (zero BPA or microplastics)', 'Plastic squeeze bottles that can leach chemicals & microplastics'],
  ['Where It Comes From', 'Family hives near Guy’s Hill & Louisiana, St. Mary', 'Unknown multi-country blends'],
  ['How It Is Extracted', 'Cold-extracted and never heated', 'High-heat pasteurized'],
  ['Filtration & Pollen', 'Unfiltered, keeping natural bee pollen & enzymes intact', 'Ultra-filtered to strip pollen'],
  ['Ingredients', '100% pure wildflower honey, zero added syrup', 'Often stretched with corn or cane syrup'],
  ['Foraging Environment', 'Clean St. Mary hills away from industrial sprays', 'Large-scale commercial monoculture farms'],
  ['Taste & Color', `Shifts naturally across ${ST_MARY_FLORA.length} St. Mary seasonal flowers`, 'Flat, uniform processed sweetness'],
];
---

<BaseLayout
  title="Why Hey Hon? Nectar-Fed St. Mary Raw Honey in Glass | Hey Hon"
  description="Why choose Hey Hon: 100% nectar-fed bees (never sugar-fed), glass bottles only with zero BPA or microplastics, cold-extracted, unfiltered raw St. Mary honey."
  canonicalPath="/why-hey-hon"
  schemas={schemas}
>
  <section class="mx-auto max-w-[1400px] px-3 sm:px-6 pt-4 pb-5">
    <div class="velvet-studio-shell px-5 py-8 sm:px-10 lg:px-14 lg:py-11">
      <div class="max-w-3xl">
        <span class="inline-flex w-fit items-center rounded-full border border-gold-bright/30 bg-white/6 px-3 py-1 text-[11px] font-medium text-gold-bright">
          The Hey Hon Standard
        </span>
        <h1 class="mt-3 font-serif text-4xl sm:text-6xl font-bold text-ivory">
          Why Hey Hon?
        </h1>
        <p class="mt-2.5 text-sm sm:text-lg text-ivory/80 leading-relaxed">
          What separates real, nectar-fed Jamaican raw honey in glass from supermarket squeeze bottles.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-3 sm:px-6 pb-8">
    <div class="light-studio-shell px-4 py-10 sm:px-10 lg:px-14 space-y-12">
      <div class="glass-pearl overflow-hidden rounded-2xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-obsidian text-ivory text-xs uppercase tracking-wider">
              <tr>
                <th class="px-5 py-4">Standard</th>
                <th class="px-5 py-4 text-gold-bright">Hey Hon St. Mary Raw</th>
                <th class="px-5 py-4 text-ivory/65">Commercial Supermarket Honey</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-obsidian/10">
              {rows.map(([label, heyhon, comm]) => (
                <tr>
                  <td class="px-5 py-4 font-semibold text-ink">{label}</td>
                  <td class="px-5 py-4 text-ink bg-gold/10 font-medium">
                    <span class="text-gold-deep font-bold">✓</span> {heyhon}
                  </td>
                  <td class="px-5 py-4 text-ink-muted">{comm}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        <div class="glass-pearl rounded-2xl p-6">
          <span class="text-xs font-semibold uppercase tracking-wide text-gold-deep">Never Sugar-Fed</span>
          <h2 class="mt-1.5 font-serif text-2xl font-bold text-ink">100% Nectar-Fed Bees</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Many commercial yards feed colonies cheap sugar syrup to rush output, leaving watery sweetener stripped of real flower benefits. Our bees forage exclusively on wildflower nectar, producing living honey packed with plant antioxidants, natural enzymes, and true St. Mary taste.
          </p>
        </div>

        <div class="glass-pearl rounded-2xl p-6">
          <span class="text-xs font-semibold uppercase tracking-wide text-gold-deep">Zero BPA or Microplastics</span>
          <h2 class="mt-1.5 font-serif text-2xl font-bold text-ink">Glass Bottles Only</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Raw honey is naturally acidic. In warm tropical kitchens, plastic squeeze bottles can leach BPA, phthalates, and microplastics into your honey over time. We bottle strictly in food-grade reusable glass jars so every spoonful stays pure and uncontaminated.
          </p>
        </div>

        <div class="glass-pearl rounded-2xl p-6">
          <span class="text-xs font-semibold uppercase tracking-wide text-gold-deep">Unheated</span>
          <h2 class="mt-1.5 font-serif text-2xl font-bold text-ink">Cold-Extracted &amp; Never Heated</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            High factory pasteurization destroys heat-sensitive enzymes and delicate blossom aromas just to stop natural crystallization. We extract cold so every jar retains the living goodness the bees capped inside the comb.
          </p>
        </div>

        <div class="glass-pearl rounded-2xl p-6">
          <span class="text-xs font-semibold uppercase tracking-wide text-gold-deep">Nothing Stripped Out</span>
          <h2 class="mt-1.5 font-serif text-2xl font-bold text-ink">Unfiltered With Real Bee Pollen</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Commercial ultra-filtration removes fine pollen grains to hide cheap origins. We coarse-strain only wax bits, keeping natural St. Mary flower pollen, trace minerals, and propolis intact in every jar.
          </p>
        </div>

        <div class="glass-pearl rounded-2xl p-6">
          <span class="text-xs font-semibold uppercase tracking-wide text-gold-deep">Directly From Our Family</span>
          <h2 class="mt-1.5 font-serif text-2xl font-bold text-ink">Single-Origin St. Mary Hives</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Every drop comes straight from our family hives near Guy’s Hill and Louisiana in St. Mary, surrounded by lush pesticide-free hillsides with zero middlemen and zero blended imports.
          </p>
        </div>

        <div class="glass-pearl rounded-2xl p-6">
          <span class="text-xs font-semibold uppercase tracking-wide text-gold-deep">{ST_MARY_FLORA.length} Local Plants</span>
          <h2 class="mt-1.5 font-serif text-2xl font-bold text-ink">True Seasonal Harvests</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            We harvest in small batches along nature’s calendar. Lighter winter Logwood and Citrus flows gradually deepen into spiced summer Pimento, Moringa, Banana, and Sorrel amber across the year.
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a href="/shop" class="inline-flex w-full sm:w-auto justify-center items-center gap-2 rounded-full bg-obsidian px-8 py-4 text-sm font-semibold text-ivory hover:bg-gold-deep transition shadow-sm">
          Shop Raw Honey →
        </a>
        <a href="/st-mary-flora" class="inline-flex w-full sm:w-auto justify-center items-center gap-2 rounded-full border border-obsidian/20 bg-parchment/90 px-7 py-4 text-sm font-semibold text-ink hover:border-gold hover:text-gold-deep transition">
          Explore St. Mary Bloom Map
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
