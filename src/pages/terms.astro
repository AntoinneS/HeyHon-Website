---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BRAND } from '@/data/brand';
---

<BaseLayout
  title="Terms of Service | Hey Hon Jamaica"
  description="Terms governing purchases, live inventory reservations, delivery, and international shipping quotes at heyhonjamaica.com."
  canonicalPath="/terms"
>
  <section class="mx-auto max-w-4xl px-3 sm:px-6 py-12">
    <div class="light-studio-shell px-6 py-12 sm:px-12 space-y-6">
      <span class="font-mono text-xs uppercase tracking-widest text-gold-deep">Policy · Updated November 2026</span>
      <h1 class="font-serif text-5xl font-bold text-ink">Terms of Service</h1>
      <p class="text-sm leading-relaxed text-ink-muted">
        By placing an order on {BRAND.domain}, you agree to these terms. All retail prices are listed in Jamaican Dollars (JMD). Approximate USD, CAD, and GBP figures shown on gifting or estimator pages are for convenience only.
      </p>
      <h2 class="font-serif text-2xl font-bold text-ink">Live Batch Inventory &amp; Reservations</h2>
      <p class="text-sm leading-relaxed text-ink-muted">
        Our raw honey is harvested in limited seasonal batches from St. Mary. Initiating online checkout reserves your jars for 15 minutes; unpaid holds automatically release back into live stock.
      </p>
      <h2 class="font-serif text-2xl font-bold text-ink">Food Safety Notice</h2>
      <p class="text-sm leading-relaxed text-ink-muted">
        Raw honey should never be given to infants under 12 months of age. Natural crystallization is a normal property of unheated raw honey and does not indicate spoilage.
      </p>
    </div>
  </section>
</BaseLayout>
