---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ARTICLES } from '@/data/articles';
import { buildBreadcrumbSchema } from '@/lib/seo';

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'The Honey Hub', path: '/learn' },
  ]),
];
---

<BaseLayout
  title="Honey Guides | Purity, Storage, Travel & Flowers | Hey Hon Jamaica"
  description="Clear answers on how to spot real raw honey in Jamaica, soften crystallized honey, pack jars for US/UK/Canada flights, seasonal St. Mary flowers, gifting, and bulk orders."
  canonicalPath="/learn"
  activeNav="learn"
  schemas={schemas}
>
  <section class="pt-8 pb-6 sm:py-10 text-ink">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold-deep">
          Honey Guides
        </span>
        <h1 class="mt-2 font-serif text-4xl sm:text-6xl font-semibold text-ink">
          Everything Worth Knowing About Real Jamaican Honey
        </h1>
        <p class="mt-3 text-sm sm:text-lg text-ink-muted">
          Simple, straightforward guides on spotting pure honey, softening crystals, flying with jars, seasonal St. Mary flowers, gifting to Jamaica, and bulk ordering.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-3 sm:px-6 pb-8">
    <div class="light-studio-shell px-5 py-12 sm:px-10 lg:px-14">
      <div class="grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-3">
        {ARTICLES.map((article) => (
          <article class="group glass-pearl overflow-hidden rounded-3xl flex flex-col hover:border-gold/60 hover:-translate-y-1 transition">
            <a href={`/learn/${article.slug}`} class="block aspect-[16/10] overflow-hidden bg-obsidian">
              <img
                src={article.image}
                alt={article.title}
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </a>
            <div class="p-6 flex-1 flex flex-col">
              <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-widest text-gold-deep">
                <span>{article.category}</span>
                <span>{article.readTime}</span>
              </div>
              <h2 class="mt-2 font-serif text-2xl font-bold leading-snug text-ink group-hover:text-gold-deep transition">
                <a href={`/learn/${article.slug}`}>{article.title}</a>
              </h2>
              <p class="mt-2.5 text-sm leading-relaxed text-ink-muted line-clamp-3">{article.directAnswer}</p>
              <div class="mt-auto pt-5">
                <a href={`/learn/${article.slug}`} class="text-xs font-semibold text-gold-deep hover:underline">
                  Read Full Guide →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
