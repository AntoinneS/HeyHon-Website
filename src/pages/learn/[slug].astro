---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BRAND } from '@/data/brand';
import { ARTICLES, getArticleBySlug } from '@/data/articles';
import { buildArticleSchema, buildBreadcrumbSchema } from '@/lib/seo';

const { slug } = Astro.params;
const article = slug ? getArticleBySlug(slug) : undefined;

if (!article) {
  return Astro.redirect('/learn', 302);
}

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'The Honey Hub', path: '/learn' },
    { name: article.title, path: `/learn/${article.slug}` },
  ]),
  buildArticleSchema(article),
];
---

<BaseLayout
  title={article.metaTitle}
  description={article.metaDescription}
  canonicalPath={`/learn/${article.slug}`}
  ogImage={article.image}
  activeNav="learn"
  schemas={schemas}
>
  <section class="pt-8 pb-6 sm:py-12 text-ink">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <nav class="mb-5 flex items-center gap-2 text-xs text-ink-muted">
        <a href="/" class="hover:text-gold-deep">Home</a>
        <span>/</span>
        <a href="/learn" class="hover:text-gold-deep">The Honey Hub</a>
        <span>/</span>
        <span class="text-ink font-medium">{article.category}</span>
      </nav>

      <span class="text-xs font-semibold uppercase tracking-[0.12em] text-gold-deep">
        {article.category} · {article.readTime}
      </span>
      <h1 class="mt-2 font-serif text-3xl sm:text-5xl font-semibold leading-tight text-ink">
        {article.title}
      </h1>
      <p class="mt-3 text-xs sm:text-sm text-ink-muted">
        By{' '}
        <a href="/story" class="font-semibold text-ink hover:text-gold-deep underline underline-offset-2 transition">
          {BRAND.founder}, {BRAND.founderTitle}
        </a>{' '}
        · Guy's Hill, St. Mary · Updated {article.publishedDate}
      </p>
    </div>
  </section>

  <article class="mx-auto max-w-[1100px] px-3 sm:px-6 pb-8">
    <div class="light-studio-shell px-5 py-10 sm:px-10 lg:px-14">
      <div class="mx-auto max-w-3xl">
        <div class="glass-pearl rounded-3xl border-gold/40 p-6">
          <div class="text-xs uppercase tracking-wide text-bloom-deep font-semibold">
            In Short
          </div>
          <p class="mt-2 text-base font-medium leading-relaxed text-ink">
            {article.directAnswer}
          </p>
        </div>

        <img
          src={article.image}
          alt={article.title}
          loading="lazy"
          decoding="async"
          class="mt-8 aspect-[16/9] w-full rounded-3xl border border-ink/10 object-cover shadow-xl"
        />

        <div class="mt-10 space-y-10">
          {article.sections.map((sec) => (
            <section class="space-y-4">
              <h2 class="font-serif text-3xl font-bold text-ink">{sec.heading}</h2>
              {sec.paragraphs.map((p) => (
                <p class="text-base leading-relaxed text-ink-muted">{p}</p>
              ))}
              {sec.bullets && (
                <ul class="glass-pearl space-y-2.5 rounded-2xl p-6 text-sm leading-relaxed text-ink">
                  {sec.bullets.map((b) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-gold-deep font-bold mt-0.5">•</span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>

        <div class="mt-14 rounded-3xl border border-gold/30 bg-obsidian p-8 text-ivory space-y-5 shadow-xl gold-glow">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div>
              <div class="font-mono text-[10px] uppercase tracking-widest text-gold-bright">Experience Single-Origin St. Mary</div>
              <h3 class="mt-1 font-serif text-3xl font-bold text-ivory">Ready to Taste Real Raw Jamaican Honey?</h3>
            </div>
            <a
              href={article.relatedCta.href}
              class="shrink-0 rounded-full bg-gold px-6 py-3.5 text-xs font-semibold text-obsidian hover:bg-gold-bright transition"
            >
              {article.relatedCta.label} →
            </a>
          </div>
          <div class="flex flex-wrap gap-3 border-t border-white/10 pt-4 text-xs text-ivory/80">
            <a href="/shop/raw-st-mary-wildflower-266ml" class="hover:text-gold-bright underline underline-offset-2 transition">
              Shop 266ml Jar (JMD $2,200)
            </a>
            <span>·</span>
            <a href="/shop/raw-st-mary-wildflower-500ml" class="hover:text-gold-bright underline underline-offset-2 transition">
              Shop 500ml Jar (JMD $3,200)
            </a>
            <span>·</span>
            <a href="/delivery" class="hover:text-gold-bright underline underline-offset-2 transition">
              Islandwide Delivery &amp; Free Pickup
            </a>
            <span>·</span>
            <a href="/wholesale" class="hover:text-gold-bright underline underline-offset-2 transition">
              Wholesale (10+ Jars)
            </a>
          </div>
        </div>

        <div class="mt-14 border-t border-ink/10 pt-10">
          <h3 class="font-serif text-2xl font-bold text-ink mb-4">More from The Honey Hub</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {ARTICLES.filter((a) => a.slug !== article.slug).slice(0, 2).map((rel) => (
              <a href={`/learn/${rel.slug}`} class="glass-pearl rounded-2xl p-5 hover:border-gold/60 transition">
                <span class="font-mono text-[10px] uppercase text-gold-deep">{rel.category}</span>
                <h4 class="mt-1 font-serif text-xl font-bold text-ink">{rel.title}</h4>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
