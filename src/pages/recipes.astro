---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { RECIPES } from '@/data/recipes';
import { PRODUCTS } from '@/data/products';
import { buildBreadcrumbSchema, buildRecipeSchema } from '@/lib/seo';

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Recipes', path: '/recipes' },
  ]),
  buildRecipeSchema(RECIPES),
];
---

<BaseLayout
  title="The Tasting Room | Raw Jamaican Honey Recipes & Rituals | Hey Hon"
  description="Elevate morning coffee, matcha, savory sourdough, and Jamaican ginger-pimento wellness elixirs with cold-extracted St. Mary raw honey."
  canonicalPath="/recipes"
  schemas={schemas}
>
  <section class="pt-8 pb-6 sm:py-12 text-ink">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold-deep">The Tasting Room</span>
        <h1 class="mt-2 font-serif text-4xl sm:text-6xl font-semibold text-ink">
          Curated Rituals for Raw St. Mary Honey
        </h1>
        <p class="mt-3 text-sm sm:text-lg text-ink-muted">
          Drizzle warm or whisk into cold drinks, and avoid boiling so the natural nutrients and fresh flower taste stay intact.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-3 sm:px-6 pb-8">
    <div class="light-studio-shell px-5 py-12 sm:px-10 lg:px-14">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        {RECIPES.map((recipe) => {
          const jar = PRODUCTS.find((p) => p.sku === recipe.recommendedSku)!;
          return (
            <article class="glass-pearl overflow-hidden rounded-3xl flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden bg-obsidian">
                <span class="absolute left-4 top-4 z-10 rounded-full border border-gold/35 bg-obsidian/90 px-3 py-1 font-mono text-[10px] uppercase tracking-widest text-gold-bright">
                  {recipe.category} · {recipe.prepTimeLabel}
                </span>
                <img src={recipe.image} alt={recipe.title} loading="lazy" class="h-full w-full object-cover" />
              </div>

              <div class="p-6 sm:p-8 flex-1 flex flex-col">
                <h2 class="font-serif text-3xl font-bold text-ink">{recipe.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{recipe.summary}</p>

                <p class="mt-4 rounded-2xl border border-gold/30 bg-gold/10 px-4 py-3 text-xs text-ink">
                  <strong class="text-gold-deep">Raw Honey Tip:</strong> {recipe.tip}
                </p>

                <details class="mt-5 rounded-2xl border border-obsidian/10 bg-parchment/85 p-4">
                  <summary class="cursor-pointer list-none font-semibold text-sm text-ink flex justify-between items-center">
                    <span>View Ingredients &amp; Step-by-Step Method ({recipe.servings})</span>
                    <span class="font-mono text-gold-deep">+</span>
                  </summary>
                  <div class="mt-4 space-y-4 text-sm text-ink-muted">
                    <div>
                      <h3 class="font-mono text-[11px] uppercase tracking-wider text-gold-deep mb-2">Ingredients</h3>
                      <ul class="list-disc pl-5 space-y-1">
                        {recipe.ingredients.map((ing) => <li>{ing}</li>)}
                      </ul>
                    </div>
                    <div>
                      <h3 class="font-mono text-[11px] uppercase tracking-wider text-gold-deep mb-2">Method</h3>
                      <ol class="list-decimal pl-5 space-y-1.5">
                        {recipe.steps.map((st) => <li>{st}</li>)}
                      </ol>
                    </div>
                  </div>
                </details>

                <div class="mt-auto pt-5 flex items-center justify-between gap-3">
                  <span class="font-mono text-[11px] text-ink-muted">Best with: {jar.shortName}</span>
                  <a href={`/shop/${jar.slug}`} class="text-xs font-semibold text-gold-deep hover:underline">
                    Shop This Jar →
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
